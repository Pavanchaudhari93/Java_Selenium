<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Selenium TestNG Framework Suite"
       verbose="1"
       parallel="methods"
       thread-count="4"
       configfailurepolicy="continue">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryListener"/>
        <listener class-name="com.framework.listeners.AllureListener"/>
    </listeners>

    <!-- ======================= UI Tests ======================= -->
    <test name="UI Tests">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.ui.LoginTest"/>
        </classes>
    </test>

    <!-- ======================= API Tests ======================= -->
    <test name="API Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.api.UserApiTest"/>
        </classes>
    </test>

    <!-- ======================= Security Tests (requires ZAP) ======================= -->
    <test name="Security Tests">
        <groups>
            <run>
                <include name="security"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.tests.security.SecurityTest"/>
        </classes>
    </test>

</suite>
